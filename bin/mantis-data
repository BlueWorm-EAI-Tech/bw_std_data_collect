#!/usr/bin/env bash
set -euo pipefail
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENV_FILE="${MANTIS_DATA_ENV:-$ROOT_DIR/config/mantis_data.env}"
if [ -f "$ENV_FILE" ]; then
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
fi
export PYTHONPATH="$ROOT_DIR${PYTHONPATH:+:$PYTHONPATH}"
PYTHON_BIN="${MANTIS_PYTHON_BIN:-python3}"
exec "$PYTHON_BIN" -c 'from lerobot_mantis_runtime.cli import main; raise SystemExit(main())' "$@"
