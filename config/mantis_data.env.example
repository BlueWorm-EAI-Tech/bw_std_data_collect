# Mantis数据采集程序包现场配置示例
# 复制为config/mantis_data.env后再修改，不要提交实际现场配置。

MANTIS_ROS_PYTHON_BIN=/usr/bin/python3
MANTIS_EXTRA_PYTHONPATH=
MANTIS_EXTRA_LD_LIBRARY_PATH=

DATASET_ROOT=$HOME/mantis_data/runtime
DATASET_REPO_PREFIX=local/bw_runtime
DATASET_FPS=30
VIDEO_CODEC=libx264

COLLECT_READY_TIMEOUT_S=90
TOPIC_CHECK_TIMEOUT=20
WEB_VIEWER_HOST=127.0.0.1
WEB_VIEWER_PORT=8000
